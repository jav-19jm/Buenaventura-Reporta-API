APP_NAME="Buenaventura Reporta"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# URL pública de esta API (se usa en los enlaces firmados de verificación de correo)
APP_URL=http://localhost:8000

# URL del frontend (enlaces de los correos y redirección tras verificar el correo)
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos por CORS, separados por coma (por defecto FRONTEND_URL)
# CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=buenaventura_reporta
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# En desarrollo "log" escribe los correos en storage/logs/laravel.log.
# Para enviarlos de verdad usa smtp (p. ej. Gmail con contraseña de aplicación).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@buenaventura-reporta.local"
MAIL_FROM_NAME="${APP_NAME}"

# JWT: genera el secreto con `php artisan jwt:secret`
JWT_SECRET=
# Minutos de vigencia del token y ventana en la que puede renovarse (2 semanas)
JWT_TTL=60
JWT_REFRESH_TTL=20160

# Administrador inicial creado por `php artisan db:seed`
ADMIN_EMAIL=admin@buenaventura.local
ADMIN_PASSWORD=cambia-esta-contrasena

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
